<?xml version="1.0" encoding="utf-8"?>
<!--
    El ScrollView no es decorativo: el contenido mide ~570dp y con el botón de anuncio
    visible más una escala de fuente grande (el público de la app son instaladores y gente
    mayor) los últimos elementos — "Restaurar compra" y "Tal vez después" — quedaban fuera
    de pantalla, sin manera de cerrar el diálogo salvo tocando afuera.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_deep">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A2A44"
        android:padding="20dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨"
            android:textSize="36sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/upgrade_title"
            android:textColor="@color/accent_cyan"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/upgrade_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Lista de features Pro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/upgrade_feature_satellites"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:drawablePadding="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/upgrade_feature_wifi"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/upgrade_feature_tdt"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/upgrade_feature_ar"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/upgrade_feature_noads"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginTop="10dp"/>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1F2A44"/>

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!--
            Alto por minHeight, NO fijo: con font_scale 1.3 el texto
            "✨ Desbloquear Pro — US$ 3.99" pasa a dos líneas y con height="52dp"
            el precio quedaba cortado a la mitad. Los insets de MaterialButton
            (6dp arriba y abajo por defecto) se anulan para no comerse el alto.
        -->
        <Button
            android:id="@+id/btnBuyPro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/upgrade_btn_buy"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/bg_deep"
            android:backgroundTint="@color/accent_cyan"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/upgrade_trial_note"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"/>

        <!--
            Mismo motivo que el botón de compra: "▶ Ver un anuncio y usar 30 min
            gratis" no entra en una línea con la fuente agrandada y se truncaba en
            "…y usar 30", que deja la oferta incomprensible.
        -->
        <Button
            android:id="@+id/btnWatchAd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/upgrade_btn_watch_ad"
            android:textSize="14sp"
            android:textColor="@color/accent_cyan"
            android:backgroundTint="@android:color/transparent"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>

        <!--
            Se muestra en lugar del botón cuando el anuncio del día de esa función ya se
            usó. Sin esto el botón simplemente desaparecería y el usuario no entendería
            por qué: el mismo problema del botón muerto, al revés.
        -->
        <TextView
            android:id="@+id/tvAdUsedToday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/upgrade_ad_used_today"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/btnRestore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/upgrade_btn_restore"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="10dp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/btnDismiss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/upgrade_btn_later"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="6dp"/>

    </LinearLayout>

</LinearLayout>

</ScrollView>
